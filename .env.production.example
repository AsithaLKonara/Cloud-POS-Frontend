# ==============================================================================
# XONIT POS & ERP - FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── API Connection ──────────────────────────────────────────────────────────
# When behind the unified Nginx reverse proxy, client-side requests use relative /api/v1
# or internal http://127.0.0.1:5000/api/v1 (guarantees Next.js SSR build works even before DNS propagates)
NEXT_PUBLIC_API_URL="http://127.0.0.1:5000/api/v1"

# ─── Site URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"

# ─── Security (Cloudflare Turnstile) ──────────────────────────────────────────
# Test site key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# ─── Session Secret ──────────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ANALYZE="false"
